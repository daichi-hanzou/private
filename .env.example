OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Azure OpenAI with Microsoft Entra ID (optional)
# Individual endpoints take priority. AZURE_OPENAI_ENDPOINT is the shared fallback.
# OPENAI_MODEL and OPENAI_EMBEDDING_MODEL must be Azure deployment names.
# AZURE_OPENAI_CHAT_ENDPOINT=https://your-chat-resource.openai.azure.com/
# AZURE_OPENAI_EMBEDDING_ENDPOINT=https://your-embedding-resource.openai.azure.com/
