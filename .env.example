# Watering Phase 1 (do not commit real tokens in .env)
ESP32_BASE_URL=http://127.0.0.1:8788
ESP32_API_TOKEN=replace-with-a-long-random-token
WATERING_TIME=07:00
WATERING_DURATION_SECONDS=30
REQUEST_TIMEOUT_SECONDS=5
TIMEZONE=Asia/Tokyo
SIMULATION_MODE=false
WATERING_MAX_DURATION_SECONDS=60
WATERING_STATE_DB=~/.local/share/agentledger/watering_state.sqlite3
WATERING_LOG_PATH=~/.local/share/agentledger/watering_history.jsonl

# Classification Review (keep the real API key only in .env)
AGENTLEDGER_REVIEW_MODEL=gpt-5.6
AGENTLEDGER_REVIEW_API_KEY=
AGENTLEDGER_REVIEW_VERSION=v2
