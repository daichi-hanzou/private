OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENROUTER_API_KEY=""
GEMINI_API_KEY=""

# OpenAI (default) or Azure OpenAI with DefaultAzureCredential
COFFEEBENCH_OPENAI_PROVIDER=openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
# Underlying model must match the experiment model (without :low etc.)
AZURE_OPENAI_MODEL=gpt-5.6-sol
AZURE_OPENAI_API_VERSION=
# Azure endpoint must be the resource root (no /openai/v1 suffix).
